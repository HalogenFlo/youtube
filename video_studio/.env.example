# ==============================================================================
# TỆP CẤU HÌNH MẪU (.ENV.EXAMPLE) - AI VIDEO STUDIO
# ==============================================================================
# Hướng dẫn: Đổi tên hoặc sao chép tệp này thành .env và điền các thông tin của bạn:
#   copy .env.example .env
# LƯU Ý BẢO MẬT: Tuyệt đối không commit tệp .env thật chứa thông tin nhạy cảm lên GitHub!

# ------------------------------------------------------------------------------
# 1. TÀI KHOẢN YOUTUBE (Tùy chọn - Dùng cho tính năng tự động tải lên video)
# ------------------------------------------------------------------------------
gmailytb=your_youtube_email@gmail.com
passytb=your_youtube_password_or_app_password

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH LOCAL LLM (Ollama - Biên soạn kịch bản & Biên tập nội dung)
# ------------------------------------------------------------------------------
# Tên model Ollama đã tải về máy (ví dụ: qwen2.5:14b, qwen2.5:7b, llama3.1:8b)
OLLAMA_MODEL=qwen2.5:14b

# Context window tối đa (Tokens)
OLLAMA_NUM_CTX=8192

# Số token tối đa cho mỗi lượt sinh kịch bản
OLLAMA_NUM_PREDICT=2048

# Địa chỉ endpoint API Ollama local (mặc định port 11434)
OLLAMA_API_URL=http://localhost:11434/api/generate

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH GOOGLE FLOW & MUSEAI 3D (Tạo ảnh & Video AI qua Chrome CDP)
# ------------------------------------------------------------------------------
# Cổng điều khiển Chrome DevTools Protocol (CDP)
CHROME_DEBUG_PORT=9222

# Đường dẫn URL project Google Flow đã mở (để trống nếu muốn xưởng tự nhận diện)
# Ví dụ: https://flow.google.com/project/xxxx-yyyy-zzzz
GOOGLE_FLOW_PROJECT_URL=

# URL dịch vụ MuseAI tạo video hoạt hình 3D
MUSEAI_URL=https://muse.ai/
MUSEAI_SCENE_TIMEOUT=420
MUSEAI_MERGE_TIMEOUT=300


# ------------------------------------------------------------------------------
# 4. CẤU HÌNH BIÊN TẬP & XUẤT BẢN VIDEO
# ------------------------------------------------------------------------------
# Tốc độ khung hình chuẩn hóa (FPS) cho video cuối cùng (YouTube Shorts / TikTok)
DEFAULT_FPS=30

# Thời lượng tối đa 1 video phần (giây)
DEFAULT_MAX_DURATION=60

# Giọng đọc mặc định (Edge-TTS tiếng Việt)
# Gợi ý: vi-VN-HoaiMyNeural (Nữ miền Nam), vi-VN-NamMinhNeural (Nam miền Bắc)
DEFAULT_VOICE=vi-VN-HoaiMyNeural

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH GIAO DIỆN WEB STREAMLIT
# ------------------------------------------------------------------------------
PORT=8502
